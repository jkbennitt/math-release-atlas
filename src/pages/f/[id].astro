---
import Base from "../../layouts/Base.astro";
import { atlas, formatIso, shortSha, type Family } from "../../lib/atlas";
import { communityLabelFor, lensLabelFor } from "../../lib/lenses";
import { leanLabel } from "../../lib/lean";
import { openaiUpstreamLinks } from "../../lib/rows";

export function getStaticPaths() {
  return atlas.families.map((family) => ({
    params: { id: family.id },
    props: { family },
  }));
}

interface Props {
  family: Family;
}

const { family } = Astro.props;
const base = import.meta.env.BASE_URL;
const status = family.community?.status ?? "claimed";
const statusLabel = communityLabelFor(status);
const history = family.community?.history ?? [];
const commit = family.upstream_sha;
const direct = openaiUpstreamLinks(family);
---

<Base
  title={`${family.id} · Math Release Atlas`}
  description={`Family ${family.id} in the unofficial math release atlas, with upstream links and Lean status.`}
>
  <article class="family">
    <p class="meta"><a href={`${base}#f-${family.id}`}>Back to the table</a></p>
    <h1 data-upstream="title">{family.title}</h1>
    <p class="status-line">
      <span class={`badge ${family.lean.status}`}>{leanLabel(family.lean.status)}</span>
      <span>
        Upstream review: {family.lean.upstream_review_status}. Scope:{" "}
        <span data-upstream="scope">{family.lean.scope}</span>
      </span>
    </p>
    <p class="meta">
      Family {family.id}. Source <a href={`${base}source/openai-math/`}>{family.source}</a>.
      {" "}
      {direct.map((link, index) => (
        <>
          {index > 0 ? " · " : null}
          <a class="direct-upstream" href={link.href}>{link.label}</a>
        </>
      ))}
    </p>
    {family.caution && <p class="caution">{family.caution}</p>}
    <blockquote class="summary-lead" data-upstream="summary">{family.upstream_summary}</blockquote>

    <div class="receipts">
      <details open>
        <summary>Manuscripts</summary>
        <ul class="links">
          {
            family.manuscripts.map((item) => (
              <li>
                <a class="direct-upstream" data-upstream="manuscript" href={item.pdf}>
                  {item.title}
                </a>
                <span class="meta">
                  {" "}
                  · {formatIso(item.date)} · {item.date}
                  {item.main_result_formalized ? " · main result in formalization catalogue" : ""}
                </span>
              </li>
            ))
          }
        </ul>
      </details>

      {
        (family.lean.status !== "none" || family.lean.doc || family.lean.comparators.length > 0 || family.reasoning_trace) && (
          <details open>
            <summary>Lean files and comparator</summary>
            {family.lean.doc && (
              <p>
                <a href={family.lean.doc}>Lean note</a>
              </p>
            )}
            {
              family.lean.comparators.length > 0 && (
                <ul class="links">
                  {family.lean.comparators.map((item) => (
                    <li>
                      <a href={item.url}>{item.file.split("/").pop()}</a>
                    </li>
                  ))}
                </ul>
              )
            }
            {
              family.reasoning_trace && (
                <p>
                  <a href={family.reasoning_trace.url}>Reasoning summary</a>
                </p>
              )
            }
            {family.lean.status === "none" ? null : (
              <p class="meta">Upstream review: {family.lean.upstream_review_status}</p>
            )}
          </details>
        )
      }

      <details>
        <summary>Subject areas</summary>
        <ul>
          {family.areas.map((area) => <li>{area}</li>)}
        </ul>
        {
          family.lenses.length > 0 && (
            <>
              <h3>Lens tags</h3>
              <ul class="notes">
                {family.lenses.map((lens) => (
                  <li>
                    <a class="tag" href={`${base}lens/${lens.tag}/`}>
                      {lensLabelFor(lens.tag)}
                    </a>
                    <span class="meta"> {lens.tag}</span>
                    <p>{lens.why}</p>
                    <p class="meta">Source: {lens.source}</p>
                  </li>
                ))}
              </ul>
            </>
          )
        }
      </details>

      <details>
        <summary>Community status</summary>
        <p>
          {statusLabel}.
          {status === "claimed" && " No outside evidence is recorded on this page."}
        </p>
        {
          family.community && family.community.evidence.length > 0 && (
            <ul class="notes">
              {family.community.evidence.map((item) => (
                <li>
                  <a href={item.url}>{item.date}</a>
                  <p>{item.note}</p>
                </li>
              ))}
            </ul>
          )
        }
        <h3>Status history</h3>
        <p>
          Current status: {statusLabel}. <a href={`${base}status/`}>Status vocabulary</a>
        </p>
        {
          history.length === 0 ? (
            <p>No approved status change is recorded.</p>
          ) : (
            <ol class="notes">
              {history.map((item) => (
                <li>
                  <span>{communityLabelFor(item.status)}</span>
                  <span class="meta"> · {item.date}</span>
                  {item.url ? (
                    <span class="meta">
                      {" "}
                      · <a href={item.url}>Evidence</a>
                    </span>
                  ) : null}
                  <p>{item.note}</p>
                </li>
              ))}
            </ol>
          )
        }
      </details>

      <details>
        <summary>Citations</summary>
        <h3>Cites</h3>
        {
          family.cites.length === 0 ? (
            <p>This family cites no other family in the upstream sources.</p>
          ) : (
            <ul class="edge-list">
              {family.cites.map((edge) => (
                <li>
                  <a href={`${base}f/${edge.to}/`}>{edge.to}</a>
                  <span class="meta"> · {edge.via}</span>
                  <p class="meta">
                    Receipt: <a href={edge.url}>{edge.source}</a>
                  </p>
                </li>
              ))}
            </ul>
          )
        }
        <h3>Cited by</h3>
        {
          family.cited_by.length === 0 ? (
            <p>No other family cites this one in the upstream sources.</p>
          ) : (
            <ul class="edge-list">
              {family.cited_by.map((edge) => (
                <li>
                  <a href={`${base}f/${edge.from}/`}>{edge.from}</a>
                  <span class="meta"> · {edge.via}</span>
                  <p class="meta">
                    Receipt: <a href={edge.url}>{edge.source}</a>
                  </p>
                </li>
              ))}
            </ul>
          )
        }
      </details>

      <details>
        <summary>Provenance</summary>
        <p>
          Upstream commit{" "}
          <a href={`${atlas.upstream.repo}/commit/${commit}`}><code>{commit}</code></a>{" "}
          ({shortSha(commit)}). Titles, subject areas, and Lean links on this page are taken
          from that commit. The summary on this page is taken from that commit.
        </p>
      </details>
    </div>
  </article>
</Base>
