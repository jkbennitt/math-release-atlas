---
import Base from "../layouts/Base.astro";
import { anthropicLeanRank, atlas, dateRange, formatIso, shortSha, type AlphaProofRecord } from "../lib/atlas";
import { lensChoices, subjectChoices } from "../lib/filters";
import { leanLabel, leanRank } from "../lib/lean";
import { gapPlainStatus, openaiDirectHref, provenanceLine, sourceChip } from "../lib/rows";
import shareDocument from "../generated/share.json";

interface ShareSegment {
  count: number;
  role: "lean" | "challenge" | "partial" | "paper";
}

interface ShareRow {
  name: string;
  unit: string;
  percent: string;
  caption: string;
  shortCaption: string;
  segments: ShareSegment[];
}

interface ShareDocument {
  headline: string;
  shareHeading: string;
  sentence: string;
  legend: { role: ShareSegment["role"]; label: string }[];
  rows: ShareRow[];
}

const share = shareDocument as ShareDocument;
const commit = atlas.upstream.commit;
const counts = atlas.counts;
const generated = atlas.generated_at.slice(0, 10);
const base = import.meta.env.BASE_URL;
const subjects = subjectChoices();
const lenses = lensChoices();
const alphaproof = atlas.alphaproof;
const anthropic = atlas.anthropic;
const sources = atlas.sources.sources;
const openaiSource = sources.find((item) => item.id === "openai-math");
const apnSource = sources.find((item) => item.id === "alphaproof-nexus");
const fltRepo = anthropic.source.also[0];
const oeisGap = alphaproof.gaps.find((gap) => gap.id === "oeis-count");
const attemptedGap = alphaproof.gaps.find((gap) => gap.id === "erdos-attempted");
const totalRows = counts.families + alphaproof.counts.lean_files + anthropic.counts.releases;
const formalizationWord = anthropic.counts.formalizations === 1 ? "formalization" : "formalizations";
---

<Base
  title="Math Release Atlas"
  description="Unofficial table of the OpenAI Math catalogue, the AlphaProof Nexus Lean files, and the Anthropic releases, with links back to each pinned upstream commit."
>
  <h1 class="home-title">{share.headline}</h1>
  <section class="share" aria-labelledby="share-heading">
    <h2 id="share-heading">{share.shareHeading}</h2>
    <ol class="share-rows">
      {share.rows.map((row) => (
        <li>
          <div class="share-name">
            <span>{row.name}</span>
            <span class="share-unit">{row.unit}</span>
          </div>
          <div class="share-track">
            <div class="share-bar" role="img" aria-label={`${row.name} ${row.percent}. ${row.caption}`}>
              {row.segments.map((segment) => (
                <span class={`seg seg-${segment.role}`} style={`flex-grow: ${segment.count}`} />
              ))}
            </div>
            <span class="share-pct">{row.percent}</span>
          </div>
          <p class="share-caption share-caption-full">{row.caption}</p>
          <p class="share-caption share-caption-short">{row.shortCaption}</p>
        </li>
      ))}
    </ol>
    <ul class="share-legend">
      {share.legend.map((item) => (
        <li>
          <span class={`swatch seg-${item.role}`} />
          {item.label}
        </li>
      ))}
    </ul>
  </section>
  <p class="lede atlas-line">{share.sentence}</p>

  <div class="filters">
    <label>
      Search
      <input id="family-search" type="search" placeholder="Title, id, summary, manuscript" />
    </label>
    <label>
      Subject
      <select id="area-filter">
        <option value="">All subjects</option>
        {subjects.map((area) => <option value={area.name}>{area.name} ({area.count})</option>)}
      </select>
    </label>
    <label>
      Lens
      <select id="lens-filter">
        <option value="">All lenses</option>
        {lenses.map((lens) => (
          <option value={lens.tag} data-label={lens.label}>
            {lens.label} ({lens.count})
          </option>
        ))}
      </select>
    </label>
    <label>
      Source
      <select id="source-filter">
        <option value="">All sources</option>
        <option value="openai-math">OpenAI Math ({counts.families})</option>
        <option value="alphaproof-nexus">AlphaProof Nexus ({alphaproof.counts.lean_files})</option>
        <option value="anthropic">Anthropic ({anthropic.counts.releases})</option>
      </select>
    </label>
    <label>
      Lean status
      <select id="lean-filter">
        <option value="">All statuses</option>
        <option value="main-result-formalized">Formalized main result ({counts.main_result_formalized})</option>
        <option value="comparator-challenge-only">Comparator challenge only ({counts.comparator_challenge_only})</option>
        <option value="none">No Lean formalization ({counts.none})</option>
        <option value="new-result">New result ({anthropic.counts.new_results})</option>
        <option value="deposited">Deposited ({alphaproof.counts.lean_files})</option>
        <option value="formalization">Formalization ({anthropic.counts.formalizations})</option>
      </select>
    </label>
    <button id="filter-reset" type="button">Reset</button>
  </div>
  <p id="shown-count" class="shown">Showing {totalRows} of {totalRows}</p>
  <noscript><p>Search and sorting need JavaScript. The full table is still listed below.</p></noscript>

  <div class="table-scroll">
    <table data-family-table>
      <caption class="meta">Result families and Lean files in catalogue order, with upstream links.</caption>
      <thead>
        <tr>
          <th scope="col" data-sort="source" aria-sort="none"><button type="button" data-sort="source">Source</button></th>
          <th scope="col" data-sort="id" aria-sort="ascending"><button type="button" data-sort="id">ID</button></th>
          <th scope="col" data-sort="title" aria-sort="none"><button type="button" data-sort="title">Result</button></th>
          <th scope="col" data-sort="lean" aria-sort="none"><button type="button" data-sort="lean">Lean</button></th>
          <th scope="col" data-sort="area" aria-sort="none"><button type="button" data-sort="area">Subject</button></th>
          <th scope="col" data-sort="date" aria-sort="none"><button type="button" data-sort="date">Date</button></th>
        </tr>
      </thead>
      <tbody>
        {atlas.families.map((family) => {
          const dates = family.manuscripts.map((item) => item.date);
          return (
            <tr
              id={`f-${family.id}`}
              data-source="openai-math"
              data-id={family.id}
              data-title={family.title}
              data-area={family.areas.join(", ")}
              data-areas={family.areas.join("|")}
              data-lean={family.lean.status}
              data-lean-rank={leanRank(family.lean.status)}
              data-lenses={family.lenses.map((lens) => lens.tag).join("|")}
              data-date={dates[0]}
              data-manuscripts={family.manuscripts.length}
            >
              <td data-label="Source">
                <a class="chip direct-upstream" href={openaiDirectHref(family)}>{sourceChip("openai-math")}</a>
              </td>
              <td class="id" data-label="ID" title={family.id}>{family.id}</td>
              <td data-label="Result">
                <div class="result-line">
                  <p class="title">
                    <a data-upstream="title" href={`${base}f/${family.id}/`}>{family.title}</a>
                  </p>
                  <details class="row-more">
                    <summary>Receipt</summary>
                    <div class="receipt">
                      {family.caution && <p class="caution">{family.caution}</p>}
                      <blockquote data-upstream="summary">{family.upstream_summary}</blockquote>
                      <ul class="links">
                        {family.manuscripts.map((item) => (
                          <li>
                            <a data-upstream="manuscript" href={item.pdf}>{item.title}</a>
                            <span class="meta"> · {item.date}{item.main_result_formalized ? " · main result in formalization catalogue" : ""}</span>
                          </li>
                        ))}
                      </ul>
                      {family.lean.status !== "none" && (
                        <p class="meta">Upstream review: {family.lean.upstream_review_status}</p>
                      )}
                      {family.lean.doc && (
                        <p class="meta"><a href={family.lean.doc}>Lean note</a></p>
                      )}
                      {family.lean.comparators.length > 0 && (
                        <ul class="links">
                          {family.lean.comparators.map((item) => (
                            <li><a href={item.url}>{item.file.split("/").pop()}</a></li>
                          ))}
                        </ul>
                      )}
                      {family.reasoning_trace && (
                        <p class="meta"><a href={family.reasoning_trace.url}>Reasoning summary</a></p>
                      )}
                      {family.lenses.length > 0 && (
                        <ul class="notes">
                          {family.lenses.map((lens) => (
                            <li>
                              <a class="tag" href={`${base}lens/${lens.tag}/`}>{lens.tag}</a>
                              {" "}{lens.why} <span class="meta">Source: {lens.source}</span>
                            </li>
                          ))}
                        </ul>
                      )}
                      {family.related.length > 0 && (
                        <ul class="notes">
                          {family.related.map((item) => (
                            <li>
                              <a href={`#f-${item.to}`}>{item.to}</a>
                              {" "}({item.kind === "shared-topic" ? "our grouping, not a citation" : item.kind}): {item.why}
                              <span class="meta"> Source: {item.source}</span>
                            </li>
                          ))}
                        </ul>
                      )}
                      <p class="meta"><a href={`${base}source/`}>Source notes</a></p>
                    </div>
                  </details>
                </div>
              </td>
              <td data-label="Lean">
                <span class={`badge ${family.lean.status}`}>{leanLabel(family.lean.status)}</span>
              </td>
              <td class="subject" data-label="Subject">{family.areas.join(", ")}</td>
              <td class="date" data-label="Date">{dateRange(dates)}</td>
            </tr>
          );
        })}
        {alphaproof.records.map((record: AlphaProofRecord) => (
          <tr
            id={`apn-${record.anchor}`}
            data-source="alphaproof-nexus"
            data-id={record.anchor}
            data-title={record.statement}
            data-area={record.category}
            data-areas={record.category}
            data-lean="deposited"
            data-lean-rank="3"
            data-lenses={record.lenses.map((lens) => lens.tag).join("|")}
            data-date={alphaproof.commit_date}
            data-manuscripts={record.natural_language_proofs.length}
          >
            <td data-label="Source">
              <a class="chip direct-upstream" href={record.url}>{sourceChip("alphaproof-nexus")}</a>
            </td>
            <td class="id" data-label="ID" title={record.anchor}>{record.anchor}</td>
            <td data-label="Result">
              <div class="result-line">
                <p class="title">
                  <a class="direct-upstream" href={record.url}>{record.statement}</a>
                </p>
                <details class="row-more">
                  <summary>Receipt</summary>
                  <div class="receipt">
                    {record.scope_notes.map((note) => <p class="caution">{note}</p>)}
                    <p class="meta">Per-row provenance: {provenanceLine(record.provenance)}</p>
                    <p class="meta"><a class="direct-upstream" href={record.url}>{record.path}</a></p>
                    {record.natural_language_proofs.map((item) => (
                      <p class="meta"><a href={item.url}>{item.path}</a></p>
                    ))}
                    {record.lenses.length > 0 && (
                      <ul class="notes">
                        {record.lenses.map((lens) => (
                          <li>
                            <a class="tag" href={`${base}lens/${lens.tag}/`}>{lens.tag}</a>
                            {" "}{lens.why} <span class="meta">Source: {lens.source}</span>
                          </li>
                        ))}
                      </ul>
                    )}
                    <p class="meta"><a href={`${base}source/alphaproof-nexus/#${record.anchor}`}>Source notes</a></p>
                  </div>
                </details>
              </div>
            </td>
            <td data-label="Lean"><span class="badge deposited">Deposited</span></td>
            <td class="subject" data-label="Subject">{record.category}{record.subcategory ? ` / ${record.subcategory}` : ""}</td>
            <td class="date" data-label="Date">{formatIso(alphaproof.commit_date)}</td>
          </tr>
        ))}
        {anthropic.releases.map((release) => {
          const dated = release.paper?.v1_submitted ?? release.announcement_date ?? release.commit_date;
          const titleHref = release.paper?.url ?? release.tree_url;
          return (
            <tr
              id={`an-${release.id}`}
              data-source="anthropic"
              data-id={release.id}
              data-title={release.title}
              data-area={release.id}
              data-areas={release.id}
              data-lean={release.kind}
              data-lean-rank={anthropicLeanRank(release.kind)}
              data-lenses={release.lenses.map((lens) => lens.tag).join("|")}
              data-date={dated}
              data-manuscripts={release.paper ? 1 : 0}
            >
              <td data-label="Source">
                <a class="chip direct-upstream" href={release.tree_url}>{sourceChip("anthropic")}</a>
              </td>
              <td class="id" data-label="ID" title={release.id}>{release.id}</td>
              <td data-label="Result">
                <div class="result-line">
                  <p class="title">
                    <a class="direct-upstream" href={titleHref}>{release.title}</a>
                  </p>
                  <details class="row-more">
                    <summary>Receipt</summary>
                    <div class="receipt">
                      <p>{release.statement}</p>
                      {release.gaps.map((gap) => (
                        <p class="caution">{gapPlainStatus(gap.status)}. {gap.label}</p>
                      ))}
                      <p class="meta"><a class="direct-upstream" href={release.tree_url}>{release.path || release.repo}</a></p>
                      {release.paper && (
                        <p class="meta"><a class="direct-upstream" href={release.paper.url}>{release.paper.title}</a> · {release.paper.v1_submitted}</p>
                      )}
                      {release.lenses.length > 0 && (
                        <ul class="notes">
                          {release.lenses.map((lens) => (
                            <li>
                              <a class="tag" href={`${base}lens/${lens.tag}/`}>{lens.tag}</a>
                              {" "}{lens.why} <span class="meta">Source: {lens.source}</span>
                            </li>
                          ))}
                        </ul>
                      )}
                      {release.announcement && (
                        <p class="meta">
                          <a href={release.announcement}>Announcement</a>
                          {release.announcement_date ? ` · ${release.announcement_date}` : ""}
                        </p>
                      )}
                      <p class="meta"><a href={`${base}source/anthropic/#${release.id}`}>Source notes</a></p>
                    </div>
                  </details>
                </div>
              </td>
              <td data-label="Lean"><span class={`badge ${release.kind}`}>{release.kind_label}</span></td>
              <td class="subject" data-label="Subject">{release.id}</td>
              <td class="date" data-label="Date">{formatIso(dated)}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>

  <p class="provenance">
    {counts.none} families have no Lean formalization in this snapshot.
    Upstream review status: <strong>{atlas.upstream.review_status}</strong>.
    Formalization scope: {atlas.upstream.formalization_scope}{" "}
    Generated {generated} from{" "}
    <a href={`${atlas.upstream.repo}/commit/${commit}`}><code>{shortSha(commit)}</code></a>.{" "}
    <a href={`${atlas.upstream.repo}/blob/${commit}/overview.pdf`}>Overview PDF</a>
    {" · "}
    <a href={`${atlas.upstream.repo}/blob/${commit}/CONTENTS.md`}>Manuscript map</a>
    {" · "}
    <a href={`${base}graph/`}>Citation graph</a>
  </p>

  <ul class="catalogue">
    <li>
      <strong>OpenAI Math.</strong> {counts.families} families and {counts.manuscripts} manuscripts at{" "}
      <a href={`${atlas.upstream.repo}/commit/${commit}`}><code>{shortSha(commit)}</code></a>.
      Source id <code>openai-math</code>.
      {openaiSource && <> {openaiSource.license}. Sync: {openaiSource.sync}.</>}
    </li>
    <li>
      <strong>AlphaProof Nexus.</strong> {alphaproof.counts.lean_files} Lean files at{" "}
      <a href={`${apnSource?.repo}/commit/${alphaproof.source.commit}`}><code>{shortSha(alphaproof.source.commit)}</code></a>.
      OEIS: {oeisGap?.repo_files} of the {oeisGap?.paper_count} the paper claims are in the repo.
      Attempted list: {attemptedGap?.label}.
      Source id <code>alphaproof-nexus</code>.{" "}
      <a href={`${base}source/alphaproof-nexus/`}>Source page</a>.
    </li>
    <li>
      <strong>Anthropic.</strong> {anthropic.counts.releases} releases and {anthropic.counts.lean_files} Lean files
      ({anthropic.counts.new_results} new results, {anthropic.counts.formalizations} {formalizationWord})
      in <a href={`${anthropic.source.repo}/commit/${anthropic.source.commit}`}><code>{shortSha(anthropic.source.commit)}</code></a>{" "}
      and <a href={`${fltRepo.repo}/commit/${fltRepo.commit}`}><code>{shortSha(fltRepo.commit)}</code></a>.
      {anthropic.source.license}.{" "}
      <a href={`${base}source/anthropic/`}>Source page</a>.
    </li>
  </ul>
</Base>

<script>
  import { mountTable } from "../scripts/table";

  mountTable();
</script>
