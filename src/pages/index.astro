---
import Base from "../layouts/Base.astro";
import { atlas, dateRange, shortSha, type AlphaProofRecord } from "../lib/atlas";
import { leanLabel, leanRank } from "../lib/lean";
import { lensCounts, lensLabel } from "../lib/lenses";

const commit = atlas.upstream.commit;
const counts = atlas.counts;
const generated = atlas.generated_at.slice(0, 10);
const base = import.meta.env.BASE_URL;
const lenses = lensCounts(atlas.families);
const alphaproof = atlas.alphaproof;
const sources = atlas.sources.sources;
const openaiSource = sources.find((item) => item.id === "openai-math");
const apnSource = sources.find((item) => item.id === "alphaproof-nexus");
const oeisGap = alphaproof.gaps.find((gap) => gap.id === "oeis-count");
const attemptedGap = alphaproof.gaps.find((gap) => gap.id === "erdos-attempted");
const totalRows = counts.families + alphaproof.counts.lean_files;
---

<Base
  title="Math Release Atlas"
  description="Unofficial table of the OpenAI Math catalogue and the AlphaProof Nexus Lean files, with links back to each pinned upstream commit."
>
  <h1>Result families</h1>
  <p class="lede">
    A receipted index of two pinned upstream catalogues. Each OpenAI Math result title
    opens that family's page. The row still quotes the catalogue and links to its PDFs. Lean
    badges on those rows repeat the upstream review status. They are not peer review, and they are not
    laboratory results. AlphaProof Nexus rows link to the Lean file deposited upstream.
    This atlas did not run Lean.
  </p>
  <div class="source-grid">
    <section class="source-card">
      <h2>OpenAI Math</h2>
      <p>
        {counts.families} families and {counts.manuscripts} manuscripts at
        <a href={`${atlas.upstream.repo}/commit/${commit}`}><code>{shortSha(commit)}</code></a>.
        Source id <code>openai-math</code>.
      </p>
      {openaiSource && <p class="meta">{openaiSource.license}. Sync: {openaiSource.sync}.</p>}
    </section>
    <section class="source-card">
      <h2>AlphaProof Nexus</h2>
      <p>
        {alphaproof.counts.lean_files} Lean files
        ({alphaproof.counts.erdos} Erdős, {alphaproof.counts.oeis_files} OEIS files,
        {alphaproof.counts.stacks} Stacks, {alphaproof.counts.ai_collaborator} AI collaborator)
        at <a href={`${apnSource?.repo}/commit/${alphaproof.source.commit}`}><code>{shortSha(alphaproof.source.commit)}</code></a>.
      </p>
      <p class="meta">
        OEIS paper count {oeisGap?.paper_count}/{oeisGap?.paper_attempted}. Repository files {oeisGap?.repo_files}.
        Gap label: {oeisGap?.label}. Status {oeisGap?.status}.
        Attempted label: {attemptedGap?.label}. Status {attemptedGap?.status}.
      </p>
      <p class="meta"><a href={`${base}source/alphaproof-nexus/`}>Source page</a></p>
    </section>
  </div>
  <div class="stats">
    <div class="stat"><b>{counts.families}</b><span>families</span></div>
    <div class="stat"><b>{counts.manuscripts}</b><span>manuscripts</span></div>
    <div class="stat"><b>{counts.main_result_formalized}</b><span>formalized main results</span></div>
    <div class="stat">
      <b>{counts.comparator_challenge_only}</b><span>comparator challenge only</span>
    </div>
  </div>
  <p class="provenance">
    {counts.none} families have no Lean formalization in this snapshot.
    Upstream review status: <strong>{atlas.upstream.review_status}</strong>.
    Formalization scope: {atlas.upstream.formalization_scope}
    Generated {generated} from
    <a href={`${atlas.upstream.repo}/commit/${commit}`}><code>{shortSha(commit)}</code></a>.
    <a href={`${atlas.upstream.repo}/blob/${commit}/overview.pdf`}>Overview PDF</a>
    ·
    <a href={`${atlas.upstream.repo}/blob/${commit}/CONTENTS.md`}>Manuscript map</a>
    ·
    <a href={`${base}graph/`}>Citation graph</a>
  </p>

  <div class="filters">
    <label>
      Search
      <input id="family-search" type="search" placeholder="Title, id, summary, manuscript" />
    </label>
    <label>
      Subject
      <select id="area-filter">
        <option value="">All subjects</option>
        {atlas.areas.map((area) => <option value={area.name}>{area.name} ({area.families})</option>)}
      </select>
    </label>
    <label>
      Lens
      <select id="lens-filter">
        <option value="">All lenses</option>
        {lenses.map((lens) => (
          <option value={lens.tag}>
            {lensLabel(lens.tag)} ({lens.count})
          </option>
        ))}
      </select>
    </label>
    <label>
      Source
      <select id="source-filter">
        <option value="">All sources</option>
        <option value="openai-math">OpenAI Math ({counts.families})</option>
        <option value="alphaproof-nexus">AlphaProof Nexus ({alphaproof.counts.lean_files})</option>
      </select>
    </label>
    <label>
      Lean status
      <select id="lean-filter">
        <option value="">All statuses</option>
        <option value="main-result-formalized">Formalized main result ({counts.main_result_formalized})</option>
        <option value="comparator-challenge-only">Comparator challenge only ({counts.comparator_challenge_only})</option>
        <option value="none">No Lean formalization ({counts.none})</option>
      </select>
    </label>
    <button id="filter-reset" type="button">Reset</button>
  </div>
  <p id="shown-count" class="shown">Showing {totalRows} of {totalRows}</p>
  <noscript><p>Search and sorting need JavaScript. The full table is still listed below.</p></noscript>

  <div class="table-scroll">
    <table data-family-table>
      <caption class="meta">All result families in catalogue order, with upstream links.</caption>
      <thead>
        <tr>
          <th scope="col" data-sort="source" aria-sort="none"><button type="button" data-sort="source">Source</button></th>
          <th scope="col" data-sort="id" aria-sort="ascending"><button type="button" data-sort="id">ID</button></th>
          <th scope="col" data-sort="title" aria-sort="none"><button type="button" data-sort="title">Result</button></th>
          <th scope="col" data-sort="area" aria-sort="none"><button type="button" data-sort="area">Subject</button></th>
          <th scope="col" data-sort="lean" aria-sort="none"><button type="button" data-sort="lean">Lean</button></th>
          <th scope="col" data-sort="manuscripts" aria-sort="none"><button type="button" data-sort="manuscripts">Manuscripts</button></th>
          <th scope="col" data-sort="date" aria-sort="none"><button type="button" data-sort="date">Dates</button></th>
        </tr>
      </thead>
      <tbody>
        {atlas.families.map((family) => {
          const dates = family.manuscripts.map((item) => item.date);
          return (
            <tr
              id={`f-${family.id}`}
              data-source="openai-math"
              data-id={family.id}
              data-title={family.title}
              data-area={family.areas.join(", ")}
              data-areas={family.areas.join("|")}
              data-lean={family.lean.status}
              data-lean-rank={leanRank(family.lean.status)}
              data-lenses={family.lenses.map((lens) => lens.tag).join("|")}
              data-date={dates[0]}
              data-manuscripts={family.manuscripts.length}
            >
              <td data-label="Source"><a href={`${base}source/`}>openai-math</a></td>
              <td class="id">{family.id}</td>
              <td>
                <p class="title">
                  <a data-upstream="title" href={`${base}f/${family.id}/`}>{family.title}</a>
                </p>
                {family.caution && <p class="caution">{family.caution}</p>}
                <details>
                  <summary>Upstream summary</summary>
                  <blockquote data-upstream="summary">{family.upstream_summary}</blockquote>
                </details>
                <details>
                  <summary>Manuscripts ({family.manuscripts.length})</summary>
                  <ul class="links">
                    {family.manuscripts.map((item) => (
                      <li>
                        <a data-upstream="manuscript" href={item.pdf}>
                          {item.title}
                        </a>
                        <span class="meta"> · {item.date}{item.main_result_formalized ? " · main result in formalization catalogue" : ""}</span>
                      </li>
                    ))}
                  </ul>
                </details>
                {family.lean.doc && (
                  <p class="meta"><a href={family.lean.doc}>Lean note</a></p>
                )}
                {family.lean.comparators.length > 0 && (
                  <details>
                    <summary>Comparator files ({family.lean.comparators.length})</summary>
                    <ul class="links">
                      {family.lean.comparators.map((item) => (
                        <li><a href={item.url}>{item.file.split("/").pop()}</a></li>
                      ))}
                    </ul>
                  </details>
                )}
                {family.reasoning_trace && (
                  <p class="meta"><a href={family.reasoning_trace.url}>Reasoning summary</a></p>
                )}
                {family.lenses.length > 0 && (
                  <ul class="notes">
                    {family.lenses.map((lens) => (
                      <li>
                        <a class="tag" href={`${base}lens/${lens.tag}/`}>{lens.tag}</a>
                        {" "}{lens.why} <span class="meta">Source: {lens.source}</span>
                      </li>
                    ))}
                  </ul>
                )}
                {family.related.length > 0 && (
                  <ul class="notes">
                    {family.related.map((item) => (
                      <li>
                        <a href={`#f-${item.to}`}>{item.to}</a>
                        {" "}({item.kind === "shared-topic" ? "our grouping, not a citation" : item.kind}): {item.why}
                        <span class="meta"> Source: {item.source}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </td>
              <td data-label="Subject">{family.areas.join(", ")}</td>
              <td data-label="Lean">
                <span class={`badge ${family.lean.status}`}>{leanLabel(family.lean.status)}</span>
                {family.lean.status !== "none" && (
                  <span class="review">Upstream review: {family.lean.upstream_review_status}</span>
                )}
              </td>
              <td data-label="Manuscripts">{family.manuscripts.length}</td>
              <td data-label="Dates">{dateRange(dates)}</td>
            </tr>
          );
        })}
        {alphaproof.records.map((record: AlphaProofRecord) => (
          <tr
            id={`apn-${record.anchor}`}
            data-source="alphaproof-nexus"
            data-id={record.anchor}
            data-title={record.statement}
            data-area={record.category}
            data-areas={record.category}
            data-lean="deposited"
            data-lean-rank="3"
            data-lenses=""
            data-date={alphaproof.commit_date}
            data-manuscripts={record.natural_language_proofs.length}
          >
            <td data-label="Source"><a href={`${base}source/alphaproof-nexus/#${record.anchor}`}>alphaproof-nexus</a></td>
            <td class="id">{record.anchor}</td>
            <td>
              <p class="title">
                <a href={`${base}source/alphaproof-nexus/#${record.anchor}`}>{record.statement}</a>
              </p>
              {record.scope_notes.map((note) => <p class="caution">{note}</p>)}
              <p class="meta">Per-row provenance: {record.provenance}</p>
              <p class="meta"><a href={record.url}>{record.path}</a></p>
              {record.natural_language_proofs.map((item) => (
                <p class="meta"><a href={item.url}>{item.path}</a></p>
              ))}
            </td>
            <td data-label="Subject">{record.category}{record.subcategory ? ` / ${record.subcategory}` : ""}</td>
            <td data-label="Lean"><span class="badge deposited">Deposited</span></td>
            <td data-label="Manuscripts">{record.natural_language_proofs.length}</td>
            <td data-label="Dates">{alphaproof.commit_date}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Base>

<script>
  import { mountTable } from "../scripts/table";

  mountTable();
</script>
