---
import Base from "../../layouts/Base.astro";
import { atlas, formatIso, shortSha } from "../../lib/atlas";
import { provenanceLine } from "../../lib/rows";

const base = import.meta.env.BASE_URL;
const record = atlas.alphaproof;
const counts = record.counts;
const commit = record.source.commit;
const oeis = record.gaps.find((gap) => gap.id === "oeis-count");
const attempted = record.gaps.find((gap) => gap.id === "erdos-attempted");
const provenance = record.gaps.find((gap) => gap.id === "per-row-provenance");
---

<Base
  title="AlphaProof Nexus · Math Release Atlas"
  description="Lean files deposited in the AlphaProof Nexus results repository, with paper counts and the gaps this atlas does not fill."
>
  <article class="prose source-page">
    <p class="meta"><a href={`${base}source/`}>All sources</a></p>
    <h1>AlphaProof Nexus</h1>
    <p class="status-line">
      <span class="badge deposited">Deposited</span>
      <span>{record.check_wording}</span>
    </p>
    <p>
      Google DeepMind. Repository{" "}
      <a href={record.source.repo}>{record.source.repo}</a>.
      Commit <a href={`${record.source.repo}/commit/${commit}`}><code>{commit}</code></a>{" "}
      ({shortSha(commit)}), committed {formatIso(record.commit_date)}, message “{record.commit_subject}”.
      Paper <a href={record.paper.url}>{record.paper.title}</a>,
      arXiv {record.paper.id}. v1 submitted {formatIso(record.paper.v1_submitted)}. v2 submitted {formatIso(record.paper.v2_submitted)}.
    </p>
    <p class="summary-lead">
      {counts.lean_files} Lean files at this commit, read against the paper’s own counts.
    </p>

    <div class="receipts">
      <details open>
        <summary>Counts at this commit</summary>
        <ul id="alphaproof-counts">
          <li>{counts.erdos} Erdős Lean files.</li>
          <li>{counts.oeis_files} OEIS Lean files.</li>
          <li>{counts.stacks} Stacks Lean files.</li>
          <li>{counts.ai_collaborator} AI collaborator Lean files.</li>
          <li>{counts.lean_files} Lean files in total.</li>
          <li>{counts.natural_language_pdfs} natural-language PDFs, linked where the filename corresponds.</li>
        </ul>
        <p class="meta">
          AI collaborator folders:
          {Object.entries(record.subcounts).map(([name, value]) => `${name} ${value}`).join(", ")}.
        </p>
      </details>

      <details open>
        <summary>Gaps against the paper</summary>
        <ul>
          <li id={`gap-${oeis?.id}`}>
            OEIS: {oeis?.repo_files} of the {oeis?.paper_count} the paper claims are in the repo.
            {oeis && oeis.absent !== undefined && oeis.absent > 0 ? <> Absent {oeis.absent}.</> : null}
            {" "}Label: {oeis?.label}.
          </li>
          <li id={`gap-${attempted?.id}`}>
            Attempted list: {attempted?.repo_entries} of the {attempted?.paper_attempted} the paper lists are in the file.
            {" "}Label: {attempted?.label}.
          </li>
          <li id={`gap-${provenance?.id}`}>
            Label: {provenance?.label}. The repository has no per-file agent record.
          </li>
        </ul>
      </details>

      <details>
        <summary>Upstream quotations</summary>
        <p>These sentences are the paper’s wording, quoted here.</p>
        <blockquote data-upstream="abstract">{record.paper.abstract_claim}</blockquote>
        <blockquote data-upstream="table">{record.paper.table1_caption}</blockquote>
        <blockquote data-upstream="density">{record.paper.density_note}</blockquote>
        <blockquote data-upstream="agent-a">{record.paper.agent_a}</blockquote>
      </details>

      <details>
        <summary>Pinned commit</summary>
        <p class="meta">License: {record.source.license}. Sync: {record.source.sync}.</p>
        <p>{record.provenance.agent_d}</p>
        <p>{record.provenance.agent_a}</p>
        <p>{record.provenance.lean_paper} Repository toolchain: <code>{record.lean_toolchain}</code>.</p>
        <p>
          Upstream CI workflow <code>{record.upstream_ci}</code>.{" "}
          {record.check_wording}
        </p>
      </details>
    </div>

    <h2>Lean files</h2>
    {
      record.records.map((item) => (
        <section id={item.anchor}>
          <h3>{item.statement}</h3>
          <p class="meta">
            {item.category}
            {item.subcategory ? ` / ${item.subcategory}` : ""}.{" "}
            {item.category === "ErdosProblems"
              ? `Problem id ${item.problem_id}`
              : `Filename stem ${item.problem_id}`}.
            Per-row provenance: {provenanceLine(item.provenance)}.
          </p>
          {item.scope_notes.map((note) => (
            <p class="caution">{note}</p>
          ))}
          <p>
            <a href={item.url}>{item.path}</a>
          </p>
          {item.natural_language_proofs.length === 0 ? (
            <p class="meta">No natural-language PDF shares this filename.</p>
          ) : (
            <ul class="links">
              {item.natural_language_proofs.map((proof) => (
                <li>
                  <a href={proof.url}>{proof.path}</a>
                </li>
              ))}
            </ul>
          )}
        </section>
      ))
    }
  </article>
</Base>
