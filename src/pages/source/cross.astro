---
import Base from "../../layouts/Base.astro";
import { atlas } from "../../lib/atlas";

const base = import.meta.env.BASE_URL;
const joined = atlas.cross;
const catalogueCount = atlas.sources.sources.length;
---

<Base
  title="Cross-source problem ids · Math Release Atlas"
  description={`Erdős problem numbers named by more than one of ${catalogueCount} catalogues, and identifiers compared across them.`}
>
  <article class="prose">
    <p class="meta"><a href={`${base}source/`}>All sources</a></p>
    <h1>Cross-source problem ids</h1>
    <p>
      A row appears here only when the same Erdős problem number is named by more than one of the {catalogueCount} catalogues.
      The number has to appear as <code>erdos_&lt;digits&gt;</code>, <code>Erdos&lt;digits&gt;</code>,
      or an <code>erdosproblems.com</code> path. Titles are not compared.
    </p>
    {
      joined.shared.length === 0 ? (
        <p id="shared-problems">{joined.empty_text}</p>
      ) : (
        <ul id="shared-problems">
          {joined.shared.map((item) => (
            <li>
              Erdős #{item.number}. OpenAI Math families {item.openai_families.join(", ")}.
              AlphaProof Nexus records {item.alphaproof_records.join(", ")}.
            </li>
          ))}
        </ul>
      )
    }
    <h2>OpenAI Math numbers</h2>
    <ul id="openai-numbers">
      {
        joined.openai_numbers.map((item) => (
          <li>
            {item.number}: {item.families.map((id) => <a href={`${base}f/${id}/`}>{id}</a>)}
          </li>
        ))
      }
    </ul>
    <h2>AlphaProof Nexus numbers</h2>
    <ul id="alphaproof-numbers">
      {
        joined.alphaproof_numbers.map((item) => (
          <li>
            {item.number}: {item.records.length} Lean {item.records.length === 1 ? "file" : "files"}
          </li>
        ))
      }
    </ul>
    <h2>Anthropic identifiers</h2>
    <section id="anthropic-identifiers">
      {
        joined.shared_with_anthropic.length === 0 ? (
          <p>{joined.anthropic_empty_text}</p>
        ) : (
          <ul>
            {joined.shared_with_anthropic.map((item) => (
              <li>
                {item.kind} {item.id}
              </li>
            ))}
          </ul>
        )
      }
      <p class="meta">{joined.anthropic_identifiers.method}</p>
    </section>
  </article>
</Base>
